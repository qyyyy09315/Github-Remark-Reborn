{
  "manifest_version": 3,
  "name": "GithubRemarkReborn",
  "version": "1.1.0",
  "description": "给你的GitHub好友和关注开发者添加个性化备注，支持个人主页常驻添加入口、全场景徽章展示及跨设备云同步",
  "author": "qyyyy",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.github.com/*"
      ],
      "js": [
        "storage.js",
        "ghremark.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GithubRemark",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
